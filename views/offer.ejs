<%- include('partials/head') %>
<% const f = (typeof q!=='undefined' && q.from!==undefined) ? q : {}; %>
<section class="wrap narrow">
  <h1>Publish your ride</h1>
  <% if (typeof error!=='undefined' && error) { %><p class="err"><%= error %></p><% } %>
  <form class="form" method="post" action="/offer">
    <div class="g2">
      <label>Leaving from<input name="from" list="cities" required value="<%= f.from||'' %>"></label>
      <label>Going to<input name="to" list="cities" required value="<%= f.to||'' %>"></label>
      <label>Date<input type="date" name="date" min="<%= today %>" required value="<%= f.date||'' %>"></label>
      <label>Time<input type="time" name="time" required value="<%= f.time||'' %>"></label>
      <label>Price per seat (₹)<input type="number" name="price" min="1" required value="<%= f.price||'' %>"></label>
      <label>Empty seats<input type="number" name="seats" min="1" max="8" value="<%= f.seats||3 %>"></label>
    </div>
    <label>Car (model, colour)<input name="car" value="<%= f.car||'' %>"></label>
    <label>Message for passengers<textarea name="note" rows="3"><%= f.note||'' %></textarea></label>
    <label class="chk"><input type="checkbox" name="instant" <%= f.instant?'checked':'' %>> Instant booking (no approval needed)</label>
    <button class="btn">Publish ride</button>
    <datalist id="cities"><% cities.forEach(c=>{ %><option value="<%= c %>"><% }) %></datalist>
  </form>
</section>
<%- include('partials/foot') %>
