# Copy to .env or set these in your hosting dashboard. All are optional.
PORT=3000
MAX_FILE_MB=50
JOB_TTL_MINUTES=30
RATE_LIMIT=300
MAX_RENDER_PAGES=200
TOOL_TIMEOUT_SECONDS=120
# Required on the API host behind Vercel/Render or another trusted reverse proxy,
# so rate limiting uses each visitor's IP instead of the proxy's shared IP.
TRUST_PROXY=false
# DATA_DIR=/var/lib/docshio
