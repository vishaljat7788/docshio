# Copy to .env or set these in your hosting dashboard. All are optional.
PORT=3000
MAX_FILE_MB=50
JOB_TTL_MINUTES=30
RATE_LIMIT=60
MAX_RENDER_PAGES=200
TOOL_TIMEOUT_SECONDS=120
# Set to true when running behind a reverse proxy (nginx, Cloudflare, Render, Railway...)
TRUST_PROXY=false
