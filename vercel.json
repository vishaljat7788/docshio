{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://docxmaster-api.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://docxmaster-api.onrender.com/healthz"
    }
  ]
}
